# Android fstab file.
# The filesystem that contains the filesystem checker binary (typically /system)
# cannot specify MF_CHECK, and must come before filesystems that specify MF_CHECK.

# mount point         fstype    device                                      flags

# Super partitions — montagem e Advanced Wipe
/system             ext4      /dev/block/mapper/system                    flags=display="System";backup=1;canbewiped=1;wipeingui=1
/vendor             ext4      /dev/block/mapper/vendor                    flags=display="Vendor";backup=1;canbewiped=1;wipeingui=1

# Instalar imagem
/system_image       emmc      /dev/block/mapper/system                    flags=display="System Image";backup=1;flashimg=1;slotselect
/vendor_image       emmc      /dev/block/mapper/vendor                    flags=display="Vendor Image";backup=1;flashimg=1;slotselect

# Boot
/boot               emmc      /dev/block/by-name/boot                     flags=display="Boot";flashimg=1;backup=1;slotselect
/vendor_boot        emmc      /dev/block/by-name/vendor_boot              flags=display="Vendor Boot";flashimg=1;backup=1;slotselect
/vbmeta             emmc      /dev/block/by-name/vbmeta                   flags=display="VBMeta";flashimg=1;backup=1;slotselect
/dtbo               emmc      /dev/block/by-name/dtbo                     flags=display="DTBO";backup=1;flashimg=1;slotselect

# Sensitive data (Sem caminhos duplicados em /mnt/vendor/)
/protect_f          ext4      /dev/block/platform/bootdevice/by-name/protect1    flags=display="Protect_f";backup=1
/protect_s          ext4      /dev/block/platform/bootdevice/by-name/protect2    flags=display="Protect_s";backup=1
/nvram              emmc      /dev/block/platform/bootdevice/by-name/nvram       flags=display="Nvram";backup=1
/nvdata             ext4      /dev/block/platform/bootdevice/by-name/nvdata      flags=display="Nvdata";backup=1
/nvcfg              ext4      /dev/block/platform/bootdevice/by-name/nvcfg       flags=display="Nvcfg";backup=1
/persist            ext4      /dev/block/platform/bootdevice/by-name/persist     flags=display="Persist";backup=1

# Firmware
/logo               emmc      /dev/block/by-name/logo                     flags=display="Logo";backup=1;flashimg=1
/expdb              emmc      /dev/block/by-name/expdb
#/seccfg            emmc      /dev/block/by-name/seccfg
/tee1               emmc      /dev/block/by-name/tee1                     flags=display="TEE 1";backup=1;flashimg=1
/tee2               emmc      /dev/block/by-name/tee2                     flags=display="TEE 2";backup=1;flashimg=1
/spmfw              emmc      /dev/block/by-name/spmfw                    flags=display="SPMFW";backup=1;flashimg=1
/otp                emmc      /dev/block/by-name/otp

# Removable storage
/external_sd        vfat      /dev/block/mmcblk1p1 /dev/block/mmcblk1     flags=display="MicroSD";storage;wipeingui;removable
/usbstorage         vfat      /dev/block/sda1 /dev/block/sda              flags=fsflags=utf8;display="USB Storage";storage;wipeingui;removable
